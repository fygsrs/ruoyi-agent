diff --git a/src/api/agent/chat.js b/src/api/agent/chat.js
new file mode 100644
index 0000000..b8769e2
--- /dev/null
+++ b/src/api/agent/chat.js
@@ -0,0 +1,120 @@
+import { EventSourceParserStream } from 'eventsource-parser/stream'
+import { getToken } from '@/utils/auth'
+
+export class AgentChatError extends Error {
+  constructor(message, status) {
+    super(message)
+    this.name = 'AgentChatError'
+    this.status = status
+  }
+}
+
+async function responseError(response) {
+  if (response.headers.get('content-type')?.includes('application/json')) {
+    const payload = await response.json()
+    const detail = payload.detail
+    if (typeof detail === 'string') return detail
+    if (Array.isArray(detail)) return detail.map(item => item.msg).join('；')
+  }
+  return `请求失败（HTTP ${response.status}）`
+}
+
+function authHeaders() {
+  const token = getToken()
+  if (!token) throw new AgentChatError('登录已失效，请重新登录', 401)
+  return { Authorization: `Bearer ${token}` }
+}
+
+async function getChatResource(path, signal) {
+  const response = await fetch(`/agent-api${path}`, { headers: authHeaders(), signal })
+  if (!response.ok) throw new AgentChatError(await responseError(response), response.status)
+  return response.json()
+}
+
+export function listAgentThreads(signal) {
+  return getChatResource('/chat', signal)
+}
+
+export function getAgentThread(threadId, signal) {
+  return getChatResource(`/chat/${encodeURIComponent(threadId)}`, signal)
+}
+
+export async function deleteAgentThread(threadId, signal) {
+  const response = await fetch(`/agent-api/chat/${encodeURIComponent(threadId)}`, {
+    method: 'DELETE',
+    headers: authHeaders(),
+    signal
+  })
+  if (!response.ok) throw new AgentChatError(await responseError(response), response.status)
+}
+
+export function streamAgentChat(payload, handlers) {
+  return streamChatResource('/chat', payload, handlers)
+}
+
+export function resumeAgentChat(payload, handlers) {
+  return streamChatResource('/chat/resume', payload, handlers)
+}
+
+async function streamChatResource(path, payload, { signal, onDelta, onThread, onReview, onSources }) {
+  const response = await fetch(`/agent-api${path}`, {
+    method: 'POST',
+    headers: {
+      ...authHeaders(),
+      'Content-Type': 'application/json',
+      Accept: 'text/event-stream'
+    },
+    body: JSON.stringify(payload),
+    signal
+  })
+
+  if (!response.ok) throw new AgentChatError(await responseError(response), response.status)
+  if (!response.headers.get('content-type')?.includes('text/event-stream') || !response.body) {
+    throw new AgentChatError('服务返回的不是流式响应，请稍后重试')
+  }
+
+  const reader = response.body
+    .pipeThrough(new TextDecoderStream())
+    .pipeThrough(new EventSourceParserStream({ onError: 'terminate' }))
+    .getReader()
+
+  try {
+    while (true) {
+      const { value: event, done } = await reader.read()
+      if (done) throw new AgentChatError('连接已中断，请恢复会话查看已保存的状态')
+
+      const data = JSON.parse(event.data)
+      switch (event.event) {
+        case 'thread':
+          if (typeof data.thread_id !== 'string') throw new AgentChatError('服务返回了无效的会话编号')
+          onThread(data.thread_id)
+          break
+        case 'delta':
+          if (typeof data.text !== 'string') throw new AgentChatError('服务返回了无效的消息内容')
+          onDelta(data.text)
+          break
+        case 'sources':
+          if (!Array.isArray(data.items)) throw new AgentChatError('服务返回了无效的引用来源')
+          onSources(data.items)
+          break
+        case 'review_required':
+          if (typeof data.interrupt_id !== 'string' || data.kind !== 'user_review' || !['create', 'update', 'delete'].includes(data.operation)) {
+            throw new AgentChatError('服务返回了无效的审核请求')
+          }
+          onReview(data)
+          await reader.cancel()
+          return
+        case 'done':
+          await reader.cancel()
+          return
+        case 'error':
+          if (typeof data.message !== 'string') throw new AgentChatError('服务返回了无效的错误消息')
+          throw new AgentChatError(data.message)
+        default:
+          throw new AgentChatError('服务返回了无法识别的消息事件')
+      }
+    }
+  } finally {
+    reader.releaseLock()
+  }
+}
diff --git a/src/api/agent/knowledge.js b/src/api/agent/knowledge.js
new file mode 100644
index 0000000..d4fcd3f
--- /dev/null
+++ b/src/api/agent/knowledge.js
@@ -0,0 +1,84 @@
+import { getToken } from '@/utils/auth'
+
+export class KnowledgeApiError extends Error {
+  constructor(message, status) {
+    super(message)
+    this.name = 'KnowledgeApiError'
+    this.status = status
+  }
+}
+
+async function errorMessage(response) {
+  if (response.headers.get('content-type')?.includes('application/json')) {
+    const { detail } = await response.json()
+    if (typeof detail === 'string') return detail
+    if (Array.isArray(detail)) return detail.map(item => item.msg).join('；')
+  }
+  return `请求失败（HTTP ${response.status}）`
+}
+
+async function request(path, { method = 'GET', data, file, signal, blob = false } = {}) {
+  const token = getToken()
+  if (!token) throw new KnowledgeApiError('登录已失效，请重新登录', 401)
+  const headers = { Authorization: `Bearer ${token}` }
+  let body
+  if (file) {
+    body = new FormData()
+    body.append('file', file)
+  } else if (data !== undefined) {
+    headers['Content-Type'] = 'application/json'
+    body = JSON.stringify(data)
+  }
+  let response
+  try {
+    response = await fetch(`/agent-api/knowledge${path}`, { method, headers, body, signal })
+  } catch (error) {
+    if (error instanceof TypeError) throw new KnowledgeApiError('无法连接知识库服务，请检查网络后重试')
+    throw error
+  }
+  if (!response.ok) throw new KnowledgeApiError(await errorMessage(response), response.status)
+  if (blob) return response.blob()
+  if (response.status === 204) return
+  return response.json()
+}
+
+export function listKnowledgeBases(signal) {
+  return request('/bases', { signal })
+}
+
+export function createKnowledgeBase(data, signal) {
+  return request('/bases', { method: 'POST', data, signal })
+}
+
+export function updateKnowledgeBase(kbId, data, signal) {
+  return request(`/bases/${encodeURIComponent(kbId)}`, { method: 'PATCH', data, signal })
+}
+
+export function deleteKnowledgeBase(kbId, signal) {
+  return request(`/bases/${encodeURIComponent(kbId)}`, { method: 'DELETE', signal })
+}
+
+export function listKnowledgeDocuments(kbId, query, signal) {
+  const params = new URLSearchParams(query)
+  return request(`/bases/${encodeURIComponent(kbId)}/documents?${params}`, { signal })
+}
+
+export function uploadKnowledgeDocument(kbId, file, signal) {
+  return request(`/bases/${encodeURIComponent(kbId)}/documents`, { method: 'POST', file, signal })
+}
+
+export function reprocessKnowledgeDocument(documentId, signal) {
+  return request(`/documents/${encodeURIComponent(documentId)}/reprocess`, { method: 'POST', signal })
+}
+
+export function deleteKnowledgeDocument(documentId, signal) {
+  return request(`/documents/${encodeURIComponent(documentId)}`, { method: 'DELETE', signal })
+}
+
+export function getKnowledgeDocumentFile(documentId, signal) {
+  return request(`/documents/${encodeURIComponent(documentId)}/file`, { blob: true, signal })
+}
+
+export function getKnowledgeAsset(assetId, signal) {
+  return request(`/assets/${encodeURIComponent(assetId)}`, { blob: true, signal })
+}
diff --git a/src/composables/useAgentChat.js b/src/composables/useAgentChat.js
new file mode 100644
index 0000000..e7d9c54
--- /dev/null
+++ b/src/composables/useAgentChat.js
@@ -0,0 +1,252 @@
+import { computed, onActivated, onBeforeUnmount, onDeactivated, onMounted, ref } from 'vue'
+import { useRoute, useRouter } from 'vue-router'
+import { ElMessage } from 'element-plus'
+import { AgentChatError, deleteAgentThread, getAgentThread, listAgentThreads, resumeAgentChat, streamAgentChat } from '@/api/agent/chat'
+import { removeToken } from '@/utils/auth'
+import useUserStore from '@/store/modules/user'
+
+export const MAX_MESSAGE_LENGTH = 8000
+
+export function useAgentChat() {
+  const messages = ref([])
+  const threads = ref([])
+  const threadId = ref('')
+  const review = ref(null)
+  const isStreaming = ref(false)
+  const isLoading = ref(false)
+  const deletingThreadId = ref('')
+  const needsRecovery = ref(false)
+  const loadError = ref('')
+  const userStore = useUserStore()
+  const route = useRoute()
+  const router = useRouter()
+  let activeRequest = null
+  let isActive = true
+
+  const displayName = computed(() => userStore.nickName || userStore.name)
+  const isBusy = computed(() => isStreaming.value || isLoading.value || !!deletingThreadId.value)
+  const storageKey = computed(() => `ruoyi-agent.thread.${userStore.id}`)
+
+  function rememberThread(id) {
+    threadId.value = id
+    localStorage.setItem(storageKey.value, id)
+  }
+
+  async function expireSession() {
+    ElMessage.warning('登录已失效，请重新登录')
+    const redirect = route.fullPath
+    removeToken()
+    userStore.$patch({ token: '', id: '', name: '', nickName: '', roles: [], permissions: [] })
+    await router.replace({ path: '/login', query: { redirect } })
+  }
+
+  async function reportError(error) {
+    if (error instanceof AgentChatError && error.status === 401) await expireSession()
+    else ElMessage.error(error.message)
+  }
+
+  function restoreMessages(history) {
+    messages.value = history.map(message => ({ ...message, id: crypto.randomUUID(), status: 'complete', error: '' }))
+  }
+
+  async function refreshThreads(signal) {
+    const data = await listAgentThreads(signal)
+    threads.value = data.threads
+  }
+
+  async function readThread(id, signal) {
+    const data = await getAgentThread(id, signal)
+    rememberThread(data.thread_id)
+    restoreMessages(data.messages)
+    review.value = data.review
+    needsRecovery.value = false
+  }
+
+  async function selectConversation(id) {
+    if (!isActive || isBusy.value) return
+    const request = { controller: new AbortController() }
+    activeRequest = request
+    isLoading.value = true
+    loadError.value = ''
+    try {
+      await readThread(id, request.controller.signal)
+    } catch (error) {
+      if (request.controller.signal.aborted) return
+      loadError.value = error.message
+      await reportError(error)
+    } finally {
+      if (activeRequest === request) {
+        activeRequest = null
+        isLoading.value = false
+      }
+    }
+  }
+
+  function clearConversation() {
+    threadId.value = ''
+    localStorage.removeItem(storageKey.value)
+    messages.value = []
+    review.value = null
+    needsRecovery.value = false
+    loadError.value = ''
+  }
+
+  async function removeConversation(id) {
+    if (!isActive || isBusy.value) return false
+    const request = { controller: new AbortController() }
+    activeRequest = request
+    deletingThreadId.value = id
+    const wasCurrent = id === threadId.value
+    try {
+      await deleteAgentThread(id, request.controller.signal)
+      threads.value = threads.value.filter(thread => thread.thread_id !== id)
+      if (wasCurrent) clearConversation()
+      ElMessage.success('会话已删除')
+    } catch (error) {
+      if (!request.controller.signal.aborted) await reportError(error)
+      return false
+    } finally {
+      if (activeRequest === request) {
+        activeRequest = null
+        deletingThreadId.value = ''
+      }
+    }
+    if (wasCurrent && threads.value.length && isActive) {
+      await selectConversation(threads.value[0].thread_id)
+    }
+    return true
+  }
+
+  async function runStream(payload, mode = 'chat') {
+    const reply = { id: crypto.randomUUID(), role: 'assistant', content: '', status: 'streaming', error: '' }
+    messages.value.push(reply)
+    const message = messages.value.at(-1)
+    const request = { controller: new AbortController(), message }
+    activeRequest = request
+    isStreaming.value = true
+    loadError.value = ''
+
+    try {
+      const stream = mode === 'resume' ? resumeAgentChat : streamAgentChat
+      await stream(payload, {
+        signal: request.controller.signal,
+        onThread(id) {
+          if (activeRequest === request) rememberThread(id)
+        },
+        onDelta(text) {
+          if (activeRequest === request) message.content += text
+        },
+        onReview(data) {
+          if (activeRequest === request) review.value = data
+        },
+        onSources(data) {
+          if (activeRequest === request) message.sources = data
+        }
+      })
+      if (activeRequest !== request) return
+      message.status = 'complete'
+      await readThread(threadId.value, request.controller.signal)
+      await refreshThreads(request.controller.signal)
+    } catch (error) {
+      if (activeRequest !== request) return
+      if (request.controller.signal.aborted) message.status = 'stopped'
+      else {
+        message.status = 'error'
+        message.error = error.message
+        needsRecovery.value = error.status !== 422
+        request.controller.abort()
+        if (error instanceof AgentChatError && error.status === 401) await expireSession()
+      }
+    } finally {
+      if (activeRequest === request) {
+        activeRequest = null
+        isStreaming.value = false
+      }
+    }
+  }
+
+  function send(text) {
+    const content = text.trim()
+    if (!isActive || isBusy.value || needsRecovery.value || review.value || !threadId.value || !content) return false
+    if (content.length > MAX_MESSAGE_LENGTH) {
+      ElMessage.warning('消息不能超过 8000 字符')
+      return false
+    }
+    messages.value.push({ id: crypto.randomUUID(), role: 'user', content, status: 'complete', error: '' })
+    void runStream({ action: 'chat', thread_id: threadId.value, content })
+    return true
+  }
+
+  function submitReview(decision) {
+    if (!isActive || isBusy.value || needsRecovery.value || !review.value) return
+    void runStream({ thread_id: threadId.value, interrupt_id: review.value.interrupt_id, ...decision }, 'resume')
+  }
+
+  function stop() {
+    if (!activeRequest) return
+    const request = activeRequest
+    if (request.message) {
+      request.message.status = 'stopped'
+      needsRecovery.value = true
+    }
+    activeRequest = null
+    isStreaming.value = false
+    isLoading.value = false
+    deletingThreadId.value = ''
+    request.controller.abort()
+  }
+
+  function newConversation() {
+    if (!isActive || isBusy.value) return
+    clearConversation()
+    void runStream({ action: 'greet' })
+  }
+
+  async function initialize() {
+    const request = { controller: new AbortController() }
+    activeRequest = request
+    isLoading.value = true
+    loadError.value = ''
+    try {
+      await refreshThreads(request.controller.signal)
+      const savedId = localStorage.getItem(storageKey.value)
+      if (savedId) {
+        try {
+          await readThread(savedId, request.controller.signal)
+        } catch (error) {
+          if (!(error instanceof AgentChatError) || error.status !== 404) throw error
+          localStorage.removeItem(storageKey.value)
+          ElMessage.info('原会话已不存在，已开始新对话')
+        }
+      }
+    } catch (error) {
+      if (request.controller.signal.aborted) return
+      loadError.value = error.message
+      await reportError(error)
+    } finally {
+      if (activeRequest === request) {
+        activeRequest = null
+        isLoading.value = false
+        if (!threadId.value && !loadError.value && isActive) newConversation()
+      }
+    }
+  }
+
+  function recoverConversation() {
+    if (threadId.value) void selectConversation(threadId.value)
+    else void initialize()
+  }
+
+  function leavePage() {
+    isActive = false
+    stop()
+  }
+
+  onMounted(initialize)
+  onActivated(() => { isActive = true })
+  onDeactivated(leavePage)
+  onBeforeUnmount(leavePage)
+
+  return { messages, threads, threadId, review, isStreaming, isLoading, isBusy, deletingThreadId, needsRecovery, loadError, displayName,
+    send, stop, submitReview, newConversation, selectConversation, removeConversation, recoverConversation }
+}
