DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
RUOYI_BASE_URL=http://127.0.0.1:8080
DATABASE_URL=postgresql://your-user:your-password@your-postgres-host:5432/your-database?sslmode=disable
ANALYTICS_MYSQL_HOST=your-mysql-host
ANALYTICS_MYSQL_PORT=3306
ANALYTICS_MYSQL_USER=your-read-only-user
ANALYTICS_MYSQL_PASSWORD=your-read-only-mysql-password
ANALYTICS_MYSQL_DATABASES=your-database

# Milvus / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=your-dashscope-api-key
MILVUS_URI=http://your-milvus-host:19530
MILVUS_TOKEN=your-milvus-user:your-milvus-password
MILVUS_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
MILVUS_RERANK_MODEL=qwen3.7-text-rerank
ATTU_ADMIN_USER=your-attu-admin-user
ATTU_ADMIN_PASSWORD=your-attu-admin-password

# MinerU official cloud SDK; originals and parsed assets stay on the Python host
MINERU_API_TOKEN=your-mineru-api-token
MINERU_BASE_URL=https://mineru.net/api/v4
KNOWLEDGE_DATA_DIR=data/knowledge

# Image generation / editing uses the server-side DASHSCOPE_API_KEY above
IMAGE_MODEL=qwen-image-3.0
IMAGE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_DATA_DIR=data/images
